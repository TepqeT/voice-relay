# VM OVH, Asmodiens et site : copier en .env (chmod 600) puis remplir.
# Ne jamais partager ni versionner .env.

# Site d'administration
# Domaine public du site (enregistrement DNS A vers l'IP de la VM), sans https://
SITE_DOMAIN=
# Adresse e-mail pour Let's Encrypt (alertes d'expiration du certificat)
ACME_EMAIL=
# Portail Discord > application Voix de Pandaemonium > OAuth2 > Client Secret
DISCORD_CLIENT_SECRET=

# Voix de Pandaemonium : ecoute le salon Raid Lead (Server Members Intent active)
DISCORD_OWNER_BOT_TOKEN=

# Heraut d'Asmodae 1 a 5 : un par escouade, dans l'ordre
DISCORD_SPEAKER_BOT_TOKEN_1=
DISCORD_SPEAKER_BOT_TOKEN_2=
DISCORD_SPEAKER_BOT_TOKEN_3=
DISCORD_SPEAKER_BOT_TOKEN_4=
DISCORD_SPEAKER_BOT_TOKEN_5=

# VPS : copier en .env (chmod 600) puis remplir.
# Ne jamais partager ni versionner .env.

# Site d'administration
# Domaine public du site (enregistrement DNS A vers l'IP de la VM), sans https://
SITE_DOMAIN=
# Adresse e-mail pour Let's Encrypt (alertes d'expiration du certificat)
ACME_EMAIL=
# Portail Discord > application Voice Relay > OAuth2 > Client Secret
DISCORD_CLIENT_SECRET=

# Bot principal (Voice Relay) : ecoute le salon Raid Lead (Server Members Intent active)
DISCORD_OWNER_BOT_TOKEN=

# Bots relais (Voice Relay 1, 2...) : un par escouade, dans l'ordre, autant que voulu
DISCORD_SPEAKER_BOT_TOKEN_1=
DISCORD_SPEAKER_BOT_TOKEN_2=
DISCORD_SPEAKER_BOT_TOKEN_3=
DISCORD_SPEAKER_BOT_TOKEN_4=
DISCORD_SPEAKER_BOT_TOKEN_5=

# Paiement : lien PayPal (https://www.paypal.com/paypalme/votre-nom) et prix affiche
PAYPAL_URL=
PRICE_LABEL=
